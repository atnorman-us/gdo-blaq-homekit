--- a/source/nvs_wifi_connect.c
+++ b/source/nvs_wifi_connect.c
@@ -21,6 +21,46 @@ static const char *TAG = "nvs_wifi_connect";
 
 static int short_retry_num = 0;
 
+nvs_wifi_scan_entry_t g_nvs_wifi_scan[NVS_WIFI_SCAN_MAX];
+int g_nvs_wifi_scan_count = 0;
+
+// Blocking scan, run once while the setup AP comes up (nobody is connected
+// to it yet, so the channel hop is harmless). Keeps the strongest entry per
+// SSID so the setup page can offer a list instead of making the user type
+// a case-sensitive name.
+static void scan_networks(void)
+{
+    g_nvs_wifi_scan_count = 0;
+    if (esp_wifi_scan_start(NULL, true) != ESP_OK)
+    {
+        ESP_LOGW(TAG, "WiFi scan failed");
+        return;
+    }
+    uint16_t num = 0;
+    esp_wifi_scan_get_ap_num(&num);
+    if (num == 0) return;
+    if (num > 40) num = 40;
+    wifi_ap_record_t *recs = calloc(num, sizeof(wifi_ap_record_t));
+    if (!recs) return;
+    if (esp_wifi_scan_get_ap_records(&num, recs) == ESP_OK)
+    {
+        for (int i = 0; i < num; i++) // records arrive sorted by RSSI, strongest first
+        {
+            const char *ssid = (const char *)recs[i].ssid;
+            if (ssid[0] == 0) continue; // hidden
+            int dup = 0;
+            for (int j = 0; j < g_nvs_wifi_scan_count; j++)
+                if (strcmp(g_nvs_wifi_scan[j].ssid, ssid) == 0) { dup = 1; break; }
+            if (dup || g_nvs_wifi_scan_count >= NVS_WIFI_SCAN_MAX) continue;
+            strlcpy(g_nvs_wifi_scan[g_nvs_wifi_scan_count].ssid, ssid, sizeof(g_nvs_wifi_scan[0].ssid));
+            g_nvs_wifi_scan[g_nvs_wifi_scan_count].rssi = recs[i].rssi;
+            g_nvs_wifi_scan_count++;
+        }
+    }
+    free(recs);
+    ESP_LOGI(TAG, "WiFi scan found %d networks", g_nvs_wifi_scan_count);
+}
