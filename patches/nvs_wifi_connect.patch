+// Networks seen by the scan taken just before the setup AP starts, strongest
+// first, one entry per SSID. Read by the setup page's network picker.
+#define NVS_WIFI_SCAN_MAX 20
+typedef struct
+{
+    char ssid[33];
+    int8_t rssi;
+} nvs_wifi_scan_entry_t;
+extern nvs_wifi_scan_entry_t g_nvs_wifi_scan[NVS_WIFI_SCAN_MAX];
+extern int g_nvs_wifi_scan_count;
