+/**
+ * @brief Finds and decodes every complete V2 packet inside one UART read.
+ *
+ * A read can hold extra bytes beyond the 19-byte packet: the break is
+ * sometimes read as a leading 0x00, and - confirmed in the field, only
+ * while the motor or light is running, when frames arrive back to back -
+ * a stray byte can also land AFTER the packet. The old handling assumed
+ * every extra byte was leading and just discarded (size - 19) bytes from
+ * the front, so a 21-byte read (1 leading + packet + 1 trailing) threw
+ * away the 0x55 start byte too, leaving a perfectly valid packet shifted
+ * by one and rejected as an "RX data signature error" (always
+ * 0x01 0x00 xx - the shifted header - never random garbage). Locate each
+ * packet by its 0x55 0x01 0x00 start signature instead.
+ *
+ * @return Number of packets decoded (0 means no start signature was found).
+*/
+static int decode_rx_stream(uint8_t *buf, size_t len, size_t packet_size) {
+    static const uint8_t signature[3] = {0x55, 0x01, 0x00};
+    int decoded = 0;
+    size_t pos = 0;
+
+    while (pos + packet_size <= len) {
+        size_t off = pos;
+        while (off + packet_size <= len && memcmp(buf + off, signature, sizeof(signature)) != 0) {
+            ++off;
+        }
+        if (off + packet_size > len) {
+            break;
+        }
+        if (decoded == 0 && off + packet_size != len) {
+            ESP_LOGW(TAG, "Re-synced RX framing: packet at offset %u of %u bytes",
+                     (unsigned)off, (unsigned)len);
+        }
+        print_buffer(g_status.protocol, buf + off, false);
+        decode_packet(buf + off);
+        ++decoded;
+        pos = off + packet_size;
+    }
+    return decoded;
+}
